{
  "manifest_version": 3,
  "name": "Improved Google Tasks",
  "version": "0.1.0",
  "description": "Adds progress bars, deadline countdown alerts, and an in-progress list on top of Google Tasks.",
  "permissions": [
    "identity",
    "alarms",
    "notifications",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Improved Google Tasks",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "451080707566-srgrkuhqp4m8lc9kpfi4h3npr3f00724.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks"
    ]
  }
}